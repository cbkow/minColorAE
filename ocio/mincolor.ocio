ocio_profile_version: 2.1

# SPDX-License-Identifier: GPL-3.0-only
# minColorAE. Copyright (C) 2026 cbkow. Part of a work derived from OpenDRT v1.1.0 by Jed Smith (GPLv3); see NOTICE.
#
# GENERATED by tools/make_ocio.cpp from the minColor core; do not edit by hand.
# Linear colour conversions for After Effects, no rendering: five linear
# working spaces, sRGB, Rec.709 BT.1886 and Display P3 for delivery and viewing, and one
# view, Un-tone-mapped. The macOS display is viewer-only (AE's macOS viewport is
# Display P3 decoded as a 2.2 power) and never a delivery. No file rules: AE does
# not convert footage; minColor Input interprets media.

name: minColor
description: minColor linear conversions (no rendering). Generated by minColorAE tools/make_ocio.

roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE-XYZ-D65
  scene_linear: ACEScg
  rendering: ACEScg
  compositing_linear: ACEScg
  color_picking: sRGB
  default: Raw
  data: Raw

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  macOS (AE viewport fix):
    - !<View> {name: Un-tone-mapped, colorspace: macOS viewport}
  macOS Video (AE viewport fix):
    - !<View> {name: Un-tone-mapped, colorspace: macOS video viewport}
  sRGB:
    - !<View> {name: Un-tone-mapped, colorspace: sRGB}
  Rec.709 (BT.1886):
    - !<View> {name: Un-tone-mapped, colorspace: Rec.709 BT.1886}
  Display P3:
    - !<View> {name: Un-tone-mapped, colorspace: Display P3}

active_displays: [macOS (AE viewport fix), macOS Video (AE viewport fix), sRGB, Rec.709 (BT.1886), Display P3]
active_views: [Un-tone-mapped]
# used by roles and views, kept out of AE's colour space menus
inactive_colorspaces: [CIE-XYZ-D65, macOS viewport, macOS video viewport]

colorspaces:
  - !<ColorSpace>
    name: ACEScg
    family: ""
    bitdepth: 32f
    description: "ACES AP1 primaries, linear. minColor's default working space."
    isdata: false
    to_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.6524187326, 0.1271799207, 0.1708572805, 0, 0.2680640519, 0.6724644899, 0.05947146192, 0, -0.005469928496, 0.005182799883, 1.089344859, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: ACES2065-1
    family: ""
    bitdepth: 32f
    description: "ACES AP0 primaries, linear (the ACES interchange space)."
    isdata: false
    to_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.9386309385, -0.005741920322, 0.01756689884, 0, 0.3380936086, 0.7272139192, -0.06530749798, 0, 0.0007231215131, 0.0008184418548, 1.087516189, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: Linear Rec.709
    family: ""
    bitdepth: 32f
    description: "Rec.709 / sRGB primaries, D65, linear."
    isdata: false
    to_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.4123907983, 0.3575843275, 0.1804807931, 0, 0.212639004, 0.7151686549, 0.07219231874, 0, 0.01933081821, 0.1191947833, 0.9505321383, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: Linear P3-D65
    family: ""
    bitdepth: 32f
    description: "Display P3 / P3-D65 primaries, linear."
    isdata: false
    to_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.4865709543, 0.2656677067, 0.1982172877, 0, 0.2289745659, 0.6917385459, 0.07928691059, 0, -3.999999935e-17, 0.045113381, 1.043944359, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: Linear Rec.2020
    family: ""
    bitdepth: 32f
    description: "Rec.2020 primaries, D65, linear."
    isdata: false
    to_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.6369580626, 0.1446169019, 0.1688809693, 0, 0.2627002001, 0.6779980659, 0.05930171534, 0, 5.000000084e-17, 0.02807269245, 1.060985088, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: sRGB
    family: ""
    bitdepth: 32f
    description: "sRGB (IEC 61966-2-1): Rec.709 primaries, the piecewise sRGB curve. For delivery and viewing."
    isdata: false
    to_scene_reference: !<GroupTransform>
      children:
        - !<ExponentWithLinearTransform> {gamma: [2.4, 2.4, 2.4, 1], offset: [0.055, 0.055, 0.055, 0], style: mirror}
        - !<MatrixTransform> {matrix: [0.4123907983, 0.3575843275, 0.1804807931, 0, 0.212639004, 0.7151686549, 0.07219231874, 0, 0.01933081821, 0.1191947833, 0.9505321383, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: Rec.709 BT.1886
    family: ""
    bitdepth: 32f
    description: "Rec.709 primaries, BT.1886 (2.4 power). For delivery and viewing."
    isdata: false
    to_scene_reference: !<GroupTransform>
      children:
        - !<ExponentTransform> {value: [2.4, 2.4, 2.4, 1], style: mirror}
        - !<MatrixTransform> {matrix: [0.4123907983, 0.3575843275, 0.1804807931, 0, 0.212639004, 0.7151686549, 0.07219231874, 0, 0.01933081821, 0.1191947833, 0.9505321383, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: Display P3
    family: ""
    bitdepth: 32f
    description: "Display P3: P3-D65 primaries, the piecewise sRGB curve (Apple, the web). For delivery and for viewing on a P3 monitor."
    isdata: false
    to_scene_reference: !<GroupTransform>
      children:
        - !<ExponentWithLinearTransform> {gamma: [2.4, 2.4, 2.4, 1], offset: [0.055, 0.055, 0.055, 0], style: mirror}
        - !<MatrixTransform> {matrix: [0.4865709543, 0.2656677067, 0.1982172877, 0, 0.2289745659, 0.6917385459, 0.07928691059, 0, -3.999999935e-17, 0.045113381, 1.043944359, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: CIE-XYZ-D65
    family: ""
    bitdepth: 32f
    description: "CIE XYZ, D65, linear: the scene reference."
    isdata: false

  - !<ColorSpace>
    name: macOS viewport
    family: ""
    bitdepth: 32f
    description: "Viewer only: linear P3-D65 encoded as a 2.2 power, for AE's Display P3 viewport on macOS. Never a delivery."
    isdata: false
    to_scene_reference: !<GroupTransform>
      children:
        - !<ExponentTransform> {value: [2.2, 2.2, 2.2, 1], style: mirror}
        - !<MatrixTransform> {matrix: [0.4865709543, 0.2656677067, 0.1982172877, 0, 0.2289745659, 0.6917385459, 0.07928691059, 0, -3.999999935e-17, 0.045113381, 1.043944359, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: macOS video viewport
    family: ""
    bitdepth: 32f
    description: "Viewer only: a Rec.709 BT.1886 delivery as a Mac plays it (encoded 2.4, decoded with the sRGB curve), in AE's Display P3 2.2 viewport. Never a delivery."
    isdata: false
    to_scene_reference: !<GroupTransform>
      children:
        - !<ExponentTransform> {value: [2.2, 2.2, 2.2, 1], style: mirror}
        - !<MatrixTransform> {matrix: [0.4865709543, 0.2656677067, 0.1982172877, 0, 0.2289745659, 0.6917385459, 0.07928691059, 0, -3.999999935e-17, 0.045113381, 1.043944359, 0, 0, 0, 0, 1]}
        - !<MatrixTransform> {matrix: [0.4123907983, 0.3575843275, 0.1804807931, 0, 0.212639004, 0.7151686549, 0.07219231874, 0, 0.01933081821, 0.1191947833, 0.9505321383, 0, 0, 0, 0, 1], direction: inverse}
        - !<ExponentWithLinearTransform> {gamma: [2.4, 2.4, 2.4, 1], offset: [0.055, 0.055, 0.055, 0], style: mirror, direction: inverse}
        - !<ExponentTransform> {value: [2.4, 2.4, 2.4, 1], style: mirror}
        - !<MatrixTransform> {matrix: [0.4123907983, 0.3575843275, 0.1804807931, 0, 0.212639004, 0.7151686549, 0.07219231874, 0, 0.01933081821, 0.1191947833, 0.9505321383, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: Raw
    family: ""
    bitdepth: 32f
    description: "No transform. The default role: AE does not convert footage, minColor Input does."
    isdata: true
